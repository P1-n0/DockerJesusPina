cat > .gitignore << 'EOF'
# Virtual Environment
venv/
env/
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.pycached

# Testing and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nosetests.xml
coverage.xml
*.cover
*.log

# Docker (archivos temporales)
docker-compose.override.yml
*.dockerignore.tmp

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Desktop.ini
Thumbs.db

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Database files
*.sqlite
*.sqlite3
*.db

# Environment variables
.env
.env.local
.env.*.local
*.pem
*.key
*.crt

# Logs
*.log
logs/
*.pid
*.seed
*.pid.lock

# Backup files
*.bak
*.tmp
*.temp
*.orig
*~

# Jupyter Notebooks (si usas)
.ipynb_checkpoints/
*.ipynb

# Mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre
.pyre/
EOF
